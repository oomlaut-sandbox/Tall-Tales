{
  "expo": {
    "name": "oomlaut Reader",
    "slug": "tall-tales",
    "scheme": "oomlaut",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "backgroundColor": "#000000",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.oomlaut.reader",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "oomlaut Reader records your voice so you can read stories aloud for your child.",
        "ITSAppUsesNonExemptEncryption": false
      },
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.oomlaut.reader",
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
      ]
    },
    "plugins": [
      [
        "expo-audio",
        {
          "microphonePermission": "oomlaut Reader records your voice so you can read stories aloud for your child."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "oomlaut Reader uses your photos as pictures in the stories you make."
        }
      ]
    ],
    "web": {
      "output": "single",
      "bundler": "metro"
    },
    "extra": {
      "eas": {
        "projectId": "c1175638-16e5-4be5-b443-b93246c7ec7f"
      }
    },
    "owner": "oomlaut-code",
    "icon": "./assets/icon.png",
    "splash": {
      "backgroundColor": "#000000",
      "resizeMode": "contain"
    }
  }
}
